generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String?
  displayName    String?
  avatarUrl      String?
  avatarMimeType String?
  avatarSize     Int?
  avatarScale    Float    @default(1)
  avatarOffsetX  Float    @default(0)
  avatarOffsetY  Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}

model Asset {
  id               String    @id @default(uuid())
  symbol           String    @unique
  displaySymbol    String?
  name             String?
  description      String?
  type             String?
  exchange         String?
  mic              String?
  currency         String?
  country          String?
  industry         String?
  logoUrl          String?
  webUrl           String?
  ipoDate          String?
  marketCap        Float?
  shareOutstanding Float?
  figi             String?
  lastPrice        Float?
  dayChange        Float?
  dayChangePercent Float?
  dayHigh          Float?
  dayLow           Float?
  dayOpen          Float?
  previousClose    Float?
  quoteTimestamp   DateTime?
  rawProfile       Json?
  rawQuote         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("assets")
}
