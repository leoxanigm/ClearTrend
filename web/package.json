{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:avatar-images": "TEST_WEB_ROOT=/app node --no-warnings --experimental-strip-types /tests/scripts/test-avatar-images.mjs",
    "test:avatar-upload": "TEST_WEB_ROOT=/app node /tests/scripts/test-avatar-upload.mjs",
    "test:watchlist-file": "TEST_WEB_ROOT=/app node /tests/scripts/test-watchlist-file.mjs",
    "test:chart-export": "TEST_WEB_ROOT=/app node --no-warnings --experimental-strip-types /tests/scripts/test-chart-export.mjs",
    "test:ml-analysis": "ANALYSIS_TEST_URL=http://analysis:8000 node /tests/scripts/test-ml-analysis.mjs",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "next-intl": "^4.11.2",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
